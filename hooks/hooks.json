{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "p=python3; python3 -c '' >/dev/null 2>&1 || p=python; \"$p\" \"${CLAUDE_PLUGIN_ROOT}\"/scripts/claude-obsidian.py hook session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=python3; python3 -c '' >/dev/null 2>&1 || p=python; \"$p\" \"${CLAUDE_PLUGIN_ROOT}\"/scripts/claude-obsidian.py hook stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
